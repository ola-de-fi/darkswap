# Public Robinhood testnet RPC. Keeper mode is read-only on this network.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Address of an already deployed SealedBatchAuction. Replace before running keeper.
AUCTION_ADDRESS=0x0000000000000000000000000000000000000000
# DRY_RUN (default, read-only) | LOCAL_EXECUTE (Anvil only) | TESTNET_EXECUTE (chain 46630 only; mainnet is refused).
EXECUTION_MODE=DRY_RUN
# TESTNET_EXECUTE only: a throwaway testnet-only key. Never reuse a key that holds real funds.
KEEPER_PRIVATE_KEY=
# TestnetPriceOracle from deployments/46630.json. The keeper refreshes it from Coinbase ETH-USD spot.
ORACLE_ADDRESS=
ORACLE_PUSH_AGE_SECONDS=45
# Optional offline override for the pushed price, e.g. 3000.
# ORACLE_FIXED_PRICE_USD=
CHAIN_ID=46630
# Optional RPC override. LOCAL_EXECUTE requires http://127.0.0.1:8545 and CHAIN_ID=31337.
# RPC_URL=
# Optional RPC tuning.
RPC_TIMEOUT_MS=8000
RPC_RETRIES=2
POLL_INTERVAL_MS=3000
# Settlement is refused above the configured gas cap after applying the safety margin.
MAX_SETTLEMENT_GAS=10000000
GAS_SAFETY_BPS=1500
# Local JSON state path; treat it as operational data, not chain truth.
KEEPER_STATE_FILE=data/state.json
# Local simulation uses only Anvil's unlocked accounts; it never reads a key.
LOCAL_ANVIL_RPC_URL=http://127.0.0.1:8545
# For LOCAL_EXECUTE experiments only: address of an unlocked local Anvil account.
# LOCAL_EXECUTE_ACCOUNT=
# Deployment (forge script script/DeployTestnet.s.sol): the auction's initial keeper and the (immutable)
# TestnetPriceOracle updater. The broadcaster becomes the auction owner and can rotate the keeper via setKeeper.
KEEPER_ADDRESS=
# Optional minimum order sizes (immutable per deployment). Defaults: 0.001 WETH and 1 USDC.
# MIN_WETH_IN=1000000000000000
# MIN_USDC_IN=1000000
# Optional explorer API key for verification tooling. Leave blank if unused.
EXPLORER_API_KEY=

# Frontend: addresses must come from a verified deployment on the named chain.
NEXT_PUBLIC_DARKSWAP_AUCTION_31337=
NEXT_PUBLIC_DARKSWAP_WETH_31337=
NEXT_PUBLIC_DARKSWAP_USDC_31337=
NEXT_PUBLIC_DARKSWAP_DEPLOYMENT_BLOCK_31337=0
NEXT_PUBLIC_DARKSWAP_AUCTION_46630=
NEXT_PUBLIC_DARKSWAP_WETH_46630=
NEXT_PUBLIC_DARKSWAP_USDC_46630=
NEXT_PUBLIC_DARKSWAP_DEPLOYMENT_BLOCK_46630=
NEXT_PUBLIC_ENABLE_TESTNET_WRITES=false

# Robinhood Chain mainnet (4663). Quote token is USDG (Paxos, 6 decimals); the env slot keeps the USDC name.
# USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168, WETH 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73.
# When NEXT_PUBLIC_DARKSWAP_AUCTION_4663 is set, disconnected visitors default to mainnet.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_DARKSWAP_AUCTION_4663=
NEXT_PUBLIC_DARKSWAP_WETH_4663=
NEXT_PUBLIC_DARKSWAP_USDC_4663=
NEXT_PUBLIC_DARKSWAP_DEPLOYMENT_BLOCK_4663=
NEXT_PUBLIC_ENABLE_MAINNET_WRITES=false
